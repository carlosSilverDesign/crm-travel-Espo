{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "maxLength": 150,
      "pattern": "$noBadCharacters"
    },
    "firstName": {
      "type": "varchar",
      "maxLength": 80
    },
    "lastName": {
      "type": "varchar",
      "maxLength": 80
    },
    "passengerType": {
      "type": "enum",
      "default": "Adult",
      "options": [
        "Adult",
        "Child",
        "Infant"
      ]
    },
    "itinerario": {
      "type": "link",
      "entity": "Itinerario",
      "index": true
    },
    "contact": {
      "type": "link",
      "entity": "Contact",
      "index": true
    },
    "documentType": {
      "type": "enum",
      "required": true,
      "default": "Passport",
      "options": [
        "Passport",
        "DNI",
        "IdentityCard",
        "Other"
      ]
    },
    "documentNumber": {
      "type": "varchar",
      "maxLength": 50,
      "pattern": "$noBadCharacters"
    },
    "documentExpiration": {
      "type": "date"
    },
    "birthDate": {
      "type": "date"
    },
    "nationality": {
      "type": "varchar",
      "maxLength": 80
    },
    "dietaryRestrictions": {
      "type": "varchar",
      "maxLength": 150
    },
    "notes": {
      "type": "text"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    }
  },
  "links": {
    "itinerario": {
      "type": "belongsTo",
      "entity": "Itinerario",
      "foreign": "passengers"
    },
    "contact": {
      "type": "belongsTo",
      "entity": "Contact",
      "foreign": "passengers"
    }
  }
}