{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "maxLength": 100
    },
    "itinerario": {
      "type": "link",
      "entity": "Itinerario",
      "index": true
    },
    "dueDate": {
      "type": "date",
      "required": true
    },
    "amount": {
      "type": "currency",
      "required": true
    },
    "status": {
      "type": "enum",
      "required": true,
      "default": "Pendiente",
      "options": [
        "Pendiente",
        "Pagado",
        "Vencido",
        "Cancelado"
      ],
      "audited": true
    },
    "paymentMethod": {
      "type": "enum",
      "options": [
        "Transferencia",
        "Tarjeta",
        "Efectivo",
        "LinkDePago",
        "Otro"
      ]
    },
    "transactionId": {
      "type": "varchar",
      "maxLength": 100
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    }
  },
  "links": {
    "itinerario": {
      "type": "belongsTo",
      "entity": "Itinerario",
      "foreign": "paymentSchedules"
    },
    "payments": {
      "type": "hasMany",
      "entity": "Payment",
      "foreign": "paymentSchedule"
    }
  }
}