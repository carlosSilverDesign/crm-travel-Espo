{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "maxLength": 150,
      "pattern": "$noBadCharacters"
    },
    "supplierType": {
      "type": "enum",
      "required": true,
      "default": "Operador Local",
      "options": [
        "Hotel",
        "Operador Local",
        "Transporte",
        "Guía",
        "Aerolínea",
        "Seguros",
        "Mayorista"
      ]
    },
    "contactEmail": {
      "type": "varchar",
      "maxLength": 100,
      "pattern": "$email"
    },
    "contactPhone": {
      "type": "varchar",
      "maxLength": 30,
      "pattern": "$noBadCharacters"
    },
    "paymentTerms": {
      "type": "text"
    }
  },
  "links": {
    "itineraryItems": {
      "type": "hasMany",
      "entity": "ItineraryItem",
      "foreign": "supplier"
    },
    "budgetLines": {
      "type": "hasMany",
      "entity": "BudgetLine",
      "foreign": "supplier"
    }
  }
}