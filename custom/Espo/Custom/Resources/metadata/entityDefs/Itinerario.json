{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "maxLength": 150,
      "pattern": "$noBadCharacters"
    },
    "status": {
      "type": "enum",
      "required": true,
      "default": "Cotización",
      "options": [
        "Cotización",
        "Confirmado",
        "En Viaje",
        "Finalizado",
        "Cancelado"
      ],
      "audited": true
    },
    "destination": {
      "type": "varchar",
      "required": true,
      "maxLength": 100,
      "pattern": "$noBadCharacters"
    },
    "startDate": {
      "type": "date",
      "required": true
    },
    "endDate": {
      "type": "date",
      "required": true
    },
    "notes": {
      "type": "text"
    }
  },
  "links": {
    "opportunity": {
      "type": "belongsTo",
      "entity": "Opportunity",
      "foreign": "cItinerarios"
    },
    "items": {
      "type": "hasMany",
      "entity": "ItineraryItem",
      "foreign": "itinerario"
    },
    "budgetLines": {
      "type": "hasMany",
      "entity": "BudgetLine",
      "foreign": "itinerario"
    }
  }
}