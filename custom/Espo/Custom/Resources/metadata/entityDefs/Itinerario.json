{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "maxLength": 150,
      "pattern": "$noBadCharacters"
    },
    "status": {
      "type": "enum",
      "required": true,
      "default": "Cotización",
      "options": [
        "Cotización",
        "Confirmado",
        "En Viaje",
        "Finalizado",
        "Cancelado"
      ],
      "audited": true
    },
    "destination": {
      "type": "varchar",
      "required": true,
      "maxLength": 100,
      "pattern": "$noBadCharacters"
    },
    "startDate": {
      "type": "date",
      "required": true
    },
    "endDate": {
      "type": "date",
      "required": true
    },
    "quoteValidUntil": {
      "type": "datetime"
    },
    "whatsappStatus": {
      "type": "enum",
      "default": "NotSent",
      "options": [
        "NotSent",
        "Queued",
        "Sent",
        "Delivered",
        "Read",
        "Failed"
      ]
    },
    "totalCost": {
      "type": "currency"
    },
    "totalSelling": {
      "type": "currency"
    },
    "grossProfit": {
      "type": "currency"
    },
    "notes": {
      "type": "text"
    }
  },
  "links": {
    "opportunity": {
      "type": "belongsTo",
      "entity": "Opportunity",
      "foreign": "cItinerarios"
    },
    "items": {
      "type": "hasMany",
      "entity": "ItineraryItem",
      "foreign": "itinerario"
    },
    "budgetLines": {
      "type": "hasMany",
      "entity": "BudgetLine",
      "foreign": "itinerario"
    },
    "passengers": {
      "type": "hasMany",
      "entity": "Passenger",
      "foreign": "itinerario"
    },
    "paymentSchedules": {
      "type": "hasMany",
      "entity": "PaymentSchedule",
      "foreign": "itinerario"
    }
  }
}