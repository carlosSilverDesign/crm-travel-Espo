{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "maxLength": 150,
      "pattern": "$noBadCharacters"
    },
    "itinerario": {
      "type": "link",
      "entity": "Itinerario",
      "index": true
    },
    "supplier": {
      "type": "link",
      "entity": "Supplier",
      "index": true
    },
    "serviceType": {
      "type": "enum",
      "required": true,
      "default": "Vuelo",
      "options": [
        "Vuelo",
        "Hotel",
        "Traslado",
        "Tour",
        "Seguro",
        "Crucero",
        "Alquiler",
        "Otro"
      ],
      "audited": true
    },
    "serviceDate": {
      "type": "datetime",
      "required": true
    },
    "serviceEndDate": {
      "type": "datetime"
    },
    "origin": {
      "type": "varchar",
      "maxLength": 100
    },
    "originIata": {
      "type": "varchar",
      "maxLength": 10
    },
    "destination": {
      "type": "varchar",
      "maxLength": 100
    },
    "destinationIata": {
      "type": "varchar",
      "maxLength": 10
    },
    "carrier": {
      "type": "varchar",
      "maxLength": 100
    },
    "flightNumber": {
      "type": "varchar",
      "maxLength": 50
    },
    "cabin": {
      "type": "varchar",
      "maxLength": 50
    },
    "confirmationCode": {
      "type": "varchar",
      "maxLength": 60,
      "pattern": "$noBadCharacters"
    },
    "costPrice": {
      "type": "currency"
    },
    "sellingPrice": {
      "type": "currency"
    },
    "grossProfit": {
      "type": "currency",
      "readOnly": true
    },
    "orderIndex": {
      "type": "int",
      "default": 0
    },
    "status": {
      "type": "enum",
      "default": "Solicitado",
      "options": [
        "Solicitado",
        "Confirmado",
        "Emitido",
        "Cancelado"
      ]
    },
    "notes": {
      "type": "text"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    }
  },
  "links": {
    "itinerario": {
      "type": "belongsTo",
      "entity": "Itinerario",
      "foreign": "items"
    },
    "supplier": {
      "type": "belongsTo",
      "entity": "Supplier",
      "foreign": "itineraryItems"
    }
  }
}