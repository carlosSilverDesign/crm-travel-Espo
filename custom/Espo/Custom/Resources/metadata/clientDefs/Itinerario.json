{
  "controller": "controllers/record",
  "recordViews": {
    "detail": "custom:views/itinerario/record/detail"
  },
  "iconClass": "fas fa-route",
  "color": "#00838f",
  "boolFilterList": [
    "onlyMy",
    "currentInDestination"
  ],
  "menu": {
    "detail": {
      "buttons": [
        {
          "name": "generatePdf",
          "label": "Generar / Descargar PDF",
          "style": "primary",
          "action": "generatePdf",
          "handler": "custom:handlers/itinerario/header-actions",
          "iconClass": "fas fa-file-pdf"
        },
        {
          "name": "openPublicWeb",
          "label": "Ver Web del Viajero",
          "style": "default",
          "action": "openPublicWeb",
          "handler": "custom:handlers/itinerario/header-actions",
          "iconClass": "fas fa-external-link-alt"
        }
      ],
      "dropdown": []
    }
  },
  "operationalBoard": {
    "enabled": true,
    "primaryFilter": "currentInDestination",
    "cardFields": [
      "leadPassengerName",
      "paxCount",
      "todaysActiveService",
      "assignedSupplierName",
      "emergencyPhone",
      "chatwootChatUrl"
    ]
  }
}
