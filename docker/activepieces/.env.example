# =============================================================================
# MÓDULO 04: MOTOR DE AUTOMATIZACIONES Y COPILOTO IA (ACTIVEPIECES)
# Plantilla de Variables de Entorno (.env.example)
# =============================================================================
# INSTRUCCIONES DE SEGURIDAD PARA PRODUCCIÓN / DESPLIEGUE HETZNER:
# 1. Copie este archivo como `.env` en `docker/activepieces/.env`.
# 2. Reemplace todos los valores `*_PLACEHOLDER_*` con secretos reales generados.
# 3. NUNCA incluya el archivo `.env` final en control de versiones Git.
# 4. Asegúrese de que Activepieces, Postgres, Redis, Chatwoot y EspoCRM compartan la red
#    interna de Docker `travel_network` para evitar exponer puertos al exterior.

# -----------------------------------------------------------------------------
# 1. Configuración Base del Orquestador Activepieces
# -----------------------------------------------------------------------------
AP_ENVIRONMENT=prod
AP_ENGINE_EXECUTABLE_PATH=/usr/src/app/packages/engine/dist/main.js
AP_FRONTEND_URL=http://localhost:8082
AP_WEBHOOK_TIMEOUT_SECONDS=30
AP_EXECUTION_MODE=UNSANDBOXED
# Generar clave de 32 caracteres hexadecimales (ej: openssl rand -hex 16)
AP_ENCRYPTION_KEY=CHANGE_ME_TO_32_CHAR_HEX_KEY_1234
# Generar secreto JWT (ej: openssl rand -hex 16)
AP_JWT_SECRET=CHANGE_ME_TO_JWT_SECRET_HEX_12345

# -----------------------------------------------------------------------------
# 2. Persistencia y Base de Datos Interna (PostgreSQL)
# -----------------------------------------------------------------------------
AP_POSTGRES_HOST=postgres
AP_POSTGRES_PORT=5432
AP_POSTGRES_DATABASE=activepieces
AP_POSTGRES_USERNAME=activepieces
AP_POSTGRES_PASSWORD=CHANGE_ME_TO_POSTGRES_PASSWORD

# -----------------------------------------------------------------------------
# 3. Persistencia de Colas y Locks (Redis)
# -----------------------------------------------------------------------------
AP_REDIS_HOST=redis
AP_REDIS_PORT=6379

# -----------------------------------------------------------------------------
# 4. Integración Chatwoot (Omnicanalidad & Copiloto Asistencial)
# -----------------------------------------------------------------------------
# URL interna resoluble en travel_network (ej: http://chatwoot-web:3000)
CHATWOOT_BASE_URL=http://chatwoot-web:3000
CHATWOOT_ACCOUNT_ID=1
# Token de acceso del Bot o Usuario Agente en Chatwoot (Settings -> Integrations)
CHATWOOT_API_TOKEN=YOUR_CHATWOOT_API_TOKEN_HERE
# Etiqueta de disparo bajo demanda (Heurística 3 de Nielsen)
TRIGGER_LABEL_NAME=Cotizar

# -----------------------------------------------------------------------------
# 5. Integración EspoCRM (Catálogo de Itinerarios vía REST API Estándar)
# -----------------------------------------------------------------------------
# URL interna en travel_network
ESPOCRM_BASE_URL=http://espocrm:80
# API Key generada en EspoCRM -> Administración -> Usuarios API (Solo lectura en Itinerario)
ESPOCRM_API_KEY=YOUR_ESPOCRM_CATALOG_API_KEY_HERE

# -----------------------------------------------------------------------------
# 6. Capa Conmutable de LLM (Adapter Pattern)
# -----------------------------------------------------------------------------
# Proveedor soportado: gemini | openai | anthropic | local
LLM_PROVIDER=gemini
# Clave de API de Google AI Studio / OpenAI
LLM_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Modelo de inferencia
LLM_MODEL_NAME=gemini-1.5-flash
# Temperatura baja para garantizar determinismo y JSON estricto
LLM_TEMPERATURE=0.2
